# --- Провайдер: anthropic (ANTHROPIC_API_KEY) или openrouter (OPENROUTER_API_KEY) ---
# Если задан только OPENROUTER_API_KEY, провайдер выбирается автоматически.
CONTRACT_AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Модель (по умолчанию: anthropic/claude-opus-5 для OpenRouter, claude-opus-5 для Anthropic) ---
# CONTRACT_AGENT_MODEL=anthropic/claude-opus-5
# CONTRACT_AGENT_EXTRACTION_MODEL=anthropic/claude-opus-5

# --- Настройки под пакет (необязательно) ---
# CONTRACT_AGENT_OUR_PARTY=АО «Вектор Логистик»      # «наша» сторона: контрагентом считается другая
# CONTRACT_AGENT_NUMBER_PATTERNS=D\d{9}-\d{2};;№\s*(\S+)  # шаблоны номеров документов через ;;
# CONTRACT_AGENT_AS_OF=2026-09-27                     # дата, на которую строится свертка (по умолчанию сегодня)

# --- Прочее (значения по умолчанию) ---
# CONTRACT_AGENT_MAX_COST_USD=12          # стоп-кран по фактической стоимости вызовов
# CONTRACT_AGENT_EFFORT=high
# CONTRACT_AGENT_EXTRACTION_EFFORT=medium
# CONTRACT_AGENT_OPENROUTER_REASONING=1
# CONTRACT_AGENT_FALLBACKS=1              # только для провайдера anthropic
# CONTRACT_AGENT_INPUT=data
# CONTRACT_AGENT_WORKDIR=workdir
# CONTRACT_AGENT_MIN_CONFIDENCE=0.7
